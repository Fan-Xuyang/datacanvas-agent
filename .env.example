AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# Embeddings are a separate provider capability; DeepSeek chat does not fill this.
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_MODEL=
# Optional Qdrant vector service. Leave blank for local SQLite cosine search.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=datacanvas
# Optional Cohere-compatible cross-encoder reranker endpoint.
RERANKER_URL=
RERANKER_API_KEY=
RERANKER_MODEL=
OCR_ENABLED=false
TESSERACT_CMD=tesseract
TESSERACT_LANG=eng+chi_sim
# Set to true in shared deployments after configuring authentication tokens.
DATACANVAS_AUTH_REQUIRED=false
# For shared use, set true and replace this sample token with long random values.
# Each bearer maps to a tenant and one role: admin, analyst, or viewer.
DATACANVAS_TOKENS='{"change-this-token":{"tenant_id":"local","role":"admin","sub":"admin"}}'
# Trusted outbound MCP services; HTTP is allowed only for loopback, remote services need HTTPS.
MCP_SERVERS='[]'
# Optional per-service bearer secret, e.g. MCP_SERVER_FINANCE_TOKEN=<secret>
# Optional: path to an existing Chrome/Chromium executable
# BROWSER_EXECUTABLE=
